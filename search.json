---
layout: null
---
[
  {% for post in site.articles %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | jsonify }},
      "date": {{ post.date | date: "%B %d, %Y" | jsonify }},
      "type": "post",
      "content": {{ post.content | strip_html | truncate: 500 | jsonify }}
    },
  {% endfor %}
  {% for post in site.guides %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | jsonify }},
      "date": {{ post.date | date: "%B %d, %Y" | jsonify }},
      "type": "post",
      "content": {{ post.content | strip_html | truncate: 500 | jsonify }}
    }{% unless forloop.last and site.newsletters.size == 0 %},{% endunless %}
  {% endfor %}
  {% for newsletter in site.newsletters %}
    {
      "title": {{ newsletter.title | jsonify }},
      "url": {{ newsletter.url | jsonify }},
      "date": {{ newsletter.date | date: "%B %d, %Y" | jsonify }},
      "type": "newsletter",
      "content": {{ newsletter.content | strip_html | truncate: 500 | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
] 